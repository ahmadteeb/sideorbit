# Copy to .env and fill in. NEVER commit .env.

# --- Domain & TLS ---
ORBIT_DOMAIN=orbit.example.com
ACME_EMAIL=you@example.com
PUBLIC_URL=https://orbit.example.com

# --- Database ---
POSTGRES_PASSWORD=change-me-openssl-rand-base64-24

# --- Auth (configure at least one sign-in method: GitHub, Google or SMTP) ---
JWT_SECRET=change-me-openssl-rand-base64-48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowed native redirects (comma-separated)
NATIVE_REDIRECTS=orbit://auth/callback,http://127.0.0.1/callback

# --- Email magic links (SMTP) ---
# Leave SMTP_HOST empty to turn email sign-in off. The server requires TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Orbit <no-reply@example.com>"

# --- Web push (VAPID): leave the keys empty to turn alerts off ---
# Generate: docker compose run --rm --no-deps orbit-server vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Anisette gateway limits ---
ANISETTE_HEADERS_PER_MIN_PER_USER=60
ANISETTE_PROVISION_PER_HOUR_PER_USER=5
ANISETTE_PROVISION_PER_HOUR_PER_DEVICE=3
ANISETTE_PROVISION_PER_HOUR_PER_IP=10
ANISETTE_PROVISION_PER_HOUR_TOTAL=100
ANISETTE_REQUESTS_PER_MIN_PER_IP=120

# --- Abuse controls (D24) ---
MAX_DEVICES_PER_USER=5

# --- Monitoring ---
# Prometheus metrics on a separate port that is never published. Empty = off.
# Set to :9090 and scrape orbit-server:9090 from a container on the same network.
METRICS_ADDR=

# --- Misc ---
LOG_LEVEL=info
EVENT_RETENTION_DAYS=90
