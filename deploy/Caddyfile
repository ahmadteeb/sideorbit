{
	email {$ACME_EMAIL}
	# Empty in production; local testing adds to it (docker-compose.local.yml).
	{$ORBIT_GLOBAL_EXTRA}

	# Error logs include request headers. Caddy redacts Authorization and Cookie
	# itself, but WebSocket clients may carry their token in this one.
	log default {
		format filter {
			wrap json
			fields {
				request>headers>Sec-Websocket-Protocol delete
				# Sign-in links and OAuth callbacks carry one-time values in the query.
				request>uri query {
					replace token REDACTED
					replace code REDACTED
					replace state REDACTED
				}
				# Client addresses aren't kept (docs/SECURITY.md).
				request>remote_ip delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				resp_headers>Sec-Websocket-Protocol delete
			}
		}
	}
}

{$ORBIT_DOMAIN} {
	{$ORBIT_TLS}
	encode zstd gzip

	# Never expose internal metrics publicly
	@metrics path /metrics
	respond @metrics 404

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API, anisette gateway (incl. WebSocket) and dashboard are all served by orbit-server
	reverse_proxy orbit-server:8080
}

# Nothing here in production.
import extra/*.caddy
